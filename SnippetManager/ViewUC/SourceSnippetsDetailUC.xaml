<base:UserControlBase
    x:Class="SnippetManager.View.SourceSnippetsDetailUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:doc="clr-namespace:System.Windows.Documents"
    xmlns:local="clr-namespace:SnippetManager.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,*">
        <GroupBox
            x:Name="HelpMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>

            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Demo beenden">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=SaveEntryCommand}"
                    CommandParameter="{x:Static core:CommandButtons.SaveEntry}"
                    ToolTip="Demo beenden">
                    <Image Source="{StaticResource ResourceKey=IconSaveEntry}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            BorderBrush="Gray"
            BorderThickness="2"
            Header="Snippet Details">
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,*">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="Titel" />

                <ComboBox
                    x:Name="GruppenFilter"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="300"
                    Margin="5"
                    HorizontalAlignment="Left"
                    IsEditable="True"
                    IsTextSearchCaseSensitive="False"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding Path=GruppenSource}"
                    Text="{Binding Path=SelectedGruppeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    FontWeight="Medium"
                    Text="Beschreibung" />

                <doc:TextEditor
                    x:Name="Editor"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2" />
            </Grid>
        </GroupBox>
    </Grid>
</base:UserControlBase>
