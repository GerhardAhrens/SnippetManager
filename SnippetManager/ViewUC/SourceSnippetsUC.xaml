<base:UserControlBase
    x:Class="SnippetManager.View.SourceSnippetsUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SnippetManager.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding
            Key="Esc"
            Command="{Binding Path=GoBackCommand}"
            CommandParameter="{x:Static core:CommandButtons.GoBack}" />
        <KeyBinding
            Key="N"
            Command="{Binding Path=NewEntryCommand}"
            CommandParameter="{x:Static core:CommandButtons.NewEntry}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D"
            Command="{Binding Path=DeleteEntryCommand}"
            CommandParameter="{x:Static core:CommandButtons.DeleteEntry}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="C"
            Command="{Binding Path=CopyAsSnippetCommand}"
            CommandParameter="{x:Static core:CommandButtons.CopyAsSnippet}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,45,*">
        <GroupBox
            x:Name="SourceSnippetsMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück zum Hauptmenü">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=NewEntryCommand}"
                    CommandParameter="{x:Static core:CommandButtons.NewEntry}"
                    ToolTip="Neuer Eintrag erstellen">
                    <Image Source="{StaticResource ResourceKey=IconNewEntry}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=DeleteEntryCommand}"
                    CommandParameter="{x:Static core:CommandButtons.DeleteEntry}"
                    ToolTip="Eintrag löschen">
                    <Image Source="{StaticResource ResourceKey=IconDeleteEntry}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CopyEntryCommand}"
                    CommandParameter="{x:Static core:CommandButtons.CopyEntry}"
                    ToolTip="Eintrag kopieren">
                    <Image Source="{StaticResource ResourceKey=IconCopyEntry}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CopyAsSnippetCommand}"
                    CommandParameter="{x:Static core:CommandButtons.CopyAsSnippet}"
                    ToolTip="Ausgewähltes Snippet in die Zwischenablage kopieren">
                    <Image Source="{StaticResource ResourceKey=IconCopyAsSnippet}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CopyAsFileCommand}"
                    CommandParameter="{x:Static core:CommandButtons.CopyAsFile}"
                    ToolTip="Ausgewähltes Snippet als Datei in die Zwischenablage kopieren">
                    <Image Source="{StaticResource ResourceKey=IconCopyAsFile}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>

        <GroupBox
            x:Name="ItemFilter"
            Grid.Row="1"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Filter:" />

                <TextBox
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Text="{Binding Path=FilterText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>

        <ListBox
            x:Name="SnippetListBox"
            Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            ItemsSource="{Binding Path=SnippetSource}"
            SelectedItem="{Binding Path=SelectedSnippet, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
            SelectionMode="Single">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        BorderBrush="Gray"
                        BorderThickness="0,0,0,1"
                        CornerRadius="0">
                        <Grid ColumnDefinitions="100,250,80,100,50,*" RowDefinitions="Auto,Auto,Auto">
                            <Grid.InputBindings>
                                <MouseBinding
                                    Command="{Binding Path=DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Gesture="LeftDoubleClick" />
                            </Grid.InputBindings>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                FontSize="14"
                                FontWeight="Medium"
                                Text="Titel" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="6"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="Blue"
                                Text="{Binding Path=[Titel]}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Gruppe" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Foreground="Blue"
                                Text="{Binding Path=[Gruppe]}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="Snippet Typ" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                HorizontalAlignment="Left"
                                Foreground="Blue"
                                Text="{Binding Path=[SnippetTyp]}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="4"
                                HorizontalAlignment="Left"
                                Text="Projekt" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="5"
                                HorizontalAlignment="Left"
                                Foreground="Blue"
                                Text="{Binding Path=[Projekt]}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Text="Beschreibung" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="6"
                                Foreground="Blue"
                                Text="{Binding Path=[Beschreibung]}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</base:UserControlBase>
