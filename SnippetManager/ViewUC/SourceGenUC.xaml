<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.SourceGenUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück zum Hauptmenü">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>
        <!--#endregion Hauptmenübar-->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,5,0,5"
            BorderBrush="Gray"
            BorderThickness="0,0,0,2">
            <TextBlock FontSize="13" TextWrapping="Wrap">
                <Run FontWeight="Medium" Text="Über diesen Dialog können für verschiedene Zwecke aus vorhandene Templates Klassen erstellt werden. Aus dem Template wird ein Source erzeugt, der als Datei oder als Snippet erstellt und über die Zwischenablage an beliebiger Stelle eingefügt werden." />
            </TextBlock>
        </Border>

        <WrapPanel Grid.Row="2" Grid.Column="0">
            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.UserControlWithArgs}"
                ToolTip="Erstellen eines WPF UserControl">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=UserControlIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="UserControl" />
                </StackPanel>
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.UserControlWithArgs}"
                ToolTip="Erstellen eines WPF UserControl mit Konstruktor Parameter">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=ParameterizedUserControlIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="UserControl mit Args" />
                </StackPanel>
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.Window}"
                ToolTip="Erstellen eines WPF Window">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=WindowIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="WPF Windows" />
                </StackPanel>
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.DialogWindow}"
                ToolTip="Erstellen eines Dialog">
                <Image Source="{StaticResource ResourceKey=DialogIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.EnumClass}"
                ToolTip="Erstellen einer Enum-Klasse">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=EnumIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="Enum Klasse" />
                </StackPanel>
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.DefaultClass}"
                ToolTip="Erstellen einer Standard C# Klasse">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=ClassIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="Standard Klasse" />
                </StackPanel>
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.ExtensionClass}"
                ToolTip="Erstellen einer Static Extension Klasse">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=ExtensionClassIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="Extension Klasse" />
                </StackPanel>
            </Button>

            <Button
                Width="120"
                Height="140"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.ExtensionBlockClass}"
                ToolTip="Erstellen einer Static Extension Klasse">
                <StackPanel Orientation="Vertical">
                    <Image Source="{StaticResource ResourceKey=ExtensionBlockIcon}" Stretch="Uniform" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Medium"
                        Text="Extension Block Klasse" />
                </StackPanel>
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.InterfaceClass}"
                ToolTip="Erstellen einer Interface Klasse">
                <Image Source="{StaticResource ResourceKey=InterfaceIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.RecordClass}"
                ToolTip="Erstellen einer Record Klasse">
                <Image Source="{StaticResource ResourceKey=RecordIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.StructClass}"
                ToolTip="Erstellen einer struct Klasse">
                <Image Source="{StaticResource ResourceKey=StructIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.CustomDataTypeClass}"
                ToolTip="Erstellen einer Custom Data Type Klasse">
                <Image Source="{StaticResource ResourceKey=CustomDataTypeIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.DependencyProperty}"
                ToolTip="Erstellen einer Dependency Property">
                <Image Source="{StaticResource ResourceKey=DependencyPropertyIcon}" Stretch="Uniform" />
            </Button>

            <Button
                Width="100"
                Height="100"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                Command="{Binding Path=CreateSourceCommand}"
                CommandParameter="{x:Static core:SourceTyp.DependencyPropertyCallback}"
                ToolTip="Erstellen einer Dependency Property mit Callback-Methode">
                <Image Source="{StaticResource ResourceKey=DependencyPropertyCallbackIcon}" Stretch="Uniform" />
            </Button>
        </WrapPanel>

    </Grid>
</base:UserControlBase>
