<base:UserControlBase
    x:Class="MinimalWPF.Beispiel.SourceGenUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MinimalWPF.Beispiel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.Resources>
        <system:Double x:Key="ButtonHeight">170</system:Double>
        <system:Double x:Key="ButtonWidth">130</system:Double>

        <Style x:Key="ButtonGen" TargetType="Button">
            <Setter Property="Height" Value="{StaticResource ResourceKey=ButtonHeight}" />
            <Setter Property="Width" Value="{StaticResource ResourceKey=ButtonWidth}" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="top" />
        </Style>

    </UserControl.Resources>


    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,Auto,*">

        <!--#region Hauptmenübar-->
        <GroupBox
            x:Name="MainMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück zum Hauptmenü">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>
        <!--#endregion Hauptmenübar-->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,5,0,5"
            BorderBrush="Gray"
            BorderThickness="0,0,0,2">
            <TextBlock
                Margin="5"
                FontSize="13"
                TextWrapping="Wrap">
                <Run FontWeight="Medium" Text="Über diesen Dialog können für verschiedene Zwecke aus vorhandene Templates Klassen erstellt werden." />
                <Run FontWeight="Medium" Text="Aus dem Template wird ein Source erzeugt, der als Datei oder als Snippet erstellt und über die Zwischenablage an beliebiger Stelle eingefügt werden." />
                <LineBreak />
                <Run FontWeight="Medium" Text="Die  UserControl und Window Klassen sind auf das" />
                <Run FontWeight="Bold" Text="MinimalWPF-Template" />
                <Run Text="ausgelegt." />
            </TextBlock>
        </Border>

        <ScrollViewer
            x:Name="MyScrollViewer"
            Grid.Row="2"
            Grid.Column="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.UserControlDefault}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen eines WPF UserControl">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=UserControlIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="UserControl (Standard)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.UserControlWithoutArgs}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen eines WPF UserControl">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=UserControlIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="UserControl (mit Buttonleiste)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.UserControlWithArgs}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen eines WPF UserControl mit Konstruktor Parameter">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=ParameterizedUserControlIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="UserControl mit Konstruktor Parameter"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.Window}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen eines WPF Window">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=WindowIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="WPF Window" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.DialogWindow}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen eines Dialog Window">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=DialogIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="WPF Window mit Menübar"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.EnumClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Enum-Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=EnumIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="Enum Klasse" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.DefaultClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Standard C# Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=ClassIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="Standard Klasse" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.ExtensionClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Static Extension Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=ExtensionBlockIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="Extension Klasse (instance class)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.ExtensionBlockClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Static Extension Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=ExtensionBlockIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="Extension Block Klasse (static class)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.InterfaceClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Interface Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=InterfaceIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="Interface Klasse"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.RecordClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer Record Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=RecordIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="record Klasse (Value Object)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.StructClass}"
                    Style="{StaticResource ResourceKey=ButtonGen}"
                    ToolTip="Erstellen einer struct Klasse">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{StaticResource ResourceKey=StructIcon}" Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Medium"
                            Text="struct Klasse"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Width="100"
                    Height="100"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.CustomDataTypeClass}"
                    ToolTip="Erstellen einer MS Test Klasse">
                    <Image Source="{StaticResource ResourceKey=MsTestIcon}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="100"
                    Height="100"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CreateSourceCommand}"
                    CommandParameter="{x:Static core:SourceTyp.DependencyProperty}"
                    ToolTip="Erstellen einer für einen Validator">
                    <Image Source="{StaticResource ResourceKey=InputValidatorIcon}" Stretch="Uniform" />
                </Button>
            </WrapPanel>
        </ScrollViewer>

    </Grid>
</base:UserControlBase>
