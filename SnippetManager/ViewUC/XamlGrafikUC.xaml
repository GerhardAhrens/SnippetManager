<base:UserControlBase
    x:Class="SnippetManager.View.XamlGrafikUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SnippetManager.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="gridMain"
        Background="WhiteSmoke"
        ColumnDefinitions="*"
        RowDefinitions="Auto,45,*">
        <GroupBox
            x:Name="SourceSnippetsMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=GoBackCommand}"
                    CommandParameter="{x:Static core:CommandButtons.GoBack}"
                    ToolTip="Zurück zum vorherigen Dialog">
                    <Image Source="{StaticResource ResourceKey=IconBackToMainMenu}" Stretch="Uniform" Width="32" Height="32"/>
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=ExportXamlIconCommand}"
                    ToolTip="XAML-Icon exportieren">
                    <Image Source="{StaticResource ResourceKey=IconExport}" Stretch="Uniform" Width="32" Height="32" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=ImportXamlIconCommand}"
                    ToolTip="XAML-Icon importieren">
                    <Image Source="{StaticResource ResourceKey=IconImport}" Stretch="Uniform" Width="32" Height="32" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=ConvertCommand}"
                    ToolTip="XAML-Icon exportieren">
                    <Image Source="{StaticResource ResourceKey=IconConvert}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="50"
                    Height="50"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Command="{Binding Path=HelpCommand}"
                    CommandParameter="{x:Static core:CommandButtons.Help}"
                    DockPanel.Dock="Right"
                    ToolTip="Hilfe zum anzeigen">
                    <Image Source="{StaticResource ResourceKey=IconHelp}" Stretch="Fill" />
                </Button>
            </DockPanel>
        </GroupBox>

        <GroupBox
            x:Name="ItemFilter"
            Grid.Row="1"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Filter:" />

                <TextBox
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Text="{Binding Path=FilterText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </GroupBox>


        <Grid Grid.Row="2" Grid.Column="0">
            <ListView
                Background="White"
                BorderThickness="0"
                ItemsSource="{Binding Path=XamlItemSource}"
                SelectedItem="{Binding Path=SelectedXamlItem}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <!--  Elemente in Spaltenn anordnen  -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <!--  Tile-Darstellung  -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="160"
                            Height="160"
                            Margin="10"
                            Padding="10"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid RowDefinitions="20,*,25">
                                <CheckBox
                                    Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Path=IsSelectedItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                                <Image
                                    Grid.Row="1"
                                    Width="90"
                                    Height="90"
                                    VerticalAlignment="Top"
                                    RenderOptions.BitmapScalingMode="LowQuality"
                                    Source="{Binding Path=ImageContent}"
                                    Stretch="Uniform"
                                    ToolTip="{Binding Path=Tooltip}">
                                    <Image.InputBindings>
                                        <MouseBinding Command="{Binding Path=DataContext.ImageDoubleClickCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" MouseAction="LeftDoubleClick" />
                                    </Image.InputBindings>
                                </Image>

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Path=Title}"
                                    ToolTip="{Binding Path=Tooltip}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Grid>
    </Grid>
</base:UserControlBase>
