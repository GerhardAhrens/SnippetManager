<base:WindowBase
    x:Class="SnippetManager.View.PlaceholderDlg"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:core="clr-namespace:SnippetManager.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SnippetManager.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=WindowTitel, FallbackValue=~WindowTitel}"
    Width="600"
    Height="450"
    ResizeMode="CanMinimize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="*" RowDefinitions="auto,*">
        <!--  Inhalte zum Window  -->
        <GroupBox
            x:Name="PlaceholderMenubar"
            Grid.Row="0"
            Margin="5"
            Padding="5">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <DockPanel Grid.Row="0" Grid.Column="0">
                <Button
                    Width="40"
                    Height="40"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=CloseDialogCommand}"
                    ToolTip="Eingabe abbrechen, Dialog schließen">
                    <Image Source="{StaticResource ResourceKey=IconCloseDialog}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="40"
                    Height="40"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=ApplyChangesCommand}"
                    ToolTip="Eingabe übernehmen, Dialog schließen">
                    <Image Source="{StaticResource ResourceKey=IconApplyChanges}" Stretch="Uniform" />
                </Button>

                <Button
                    Width="40"
                    Height="40"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Command="{Binding Path=DiscardInputCommand}"
                    ToolTip="Eingabe averwerfen">
                    <Image Source="{StaticResource ResourceKey=IconCancel}" Stretch="Uniform" />
                </Button>
            </DockPanel>
        </GroupBox>

    </Grid>
</base:WindowBase>
